# 复制本文件为 .env 并改成你自己的强密码（.env 不入库，本模板入库）
# docker compose 会自动读取同目录的 .env 并替换 docker-compose.yml 里的 ${变量}

# MySQL root 密码
MYSQL_ROOT_PASSWORD=change_me_root
# 应用数据库账号 mes 的密码（backend 连接串要与它一致）
MES_DB_PASSWORD=change_me_db
# RabbitMQ 账号 mes 的密码
RABBITMQ_PASSWORD=change_me_mq
# MinIO root 密码（控制台 http://localhost:9001）
MINIO_ROOT_PASSWORD=change_me_minio
# JWT 签名密钥：至少 32 位随机字符串（泄露=任何人可伪造登录令牌）
JWT_KEY=change_me_at_least_32_chars_random_string!!
