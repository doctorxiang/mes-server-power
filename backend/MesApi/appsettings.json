{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql"
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=mes_server_power;User Id=mes;Password=${MES_DB_PASSWORD};CharSet=utf8mb4;AllowPublicKeyRetrieval=true;SslMode=None",
    "Sqlite": "Data Source=mes.db"
  },
  "Jwt": {
    "Issuer": "MesApi",
    "Audience": "MesClient",
    "Key": "change_me_jwt_key_at_least_32_chars",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Seed": {
    "AdminPassword": "Admin@12345"
  }
}
