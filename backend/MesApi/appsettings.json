{
  "Logging": {
    "LogDirectory": "logs",
    "MinimumLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "UserName": "mes",
    "Password": "${MES_DB_PASSWORD}",
    "VirtualHost": "/"
  },
  "Minio": {
    "Endpoint": "",
    "AccessKey": "mes",
    "SecretKey": "${MINIO_ROOT_PASSWORD}",
    "Bucket": "mes-docs"
  },
  "Aps": {
    "YieldLossPercent": 3
  },
  "Diagnostics": {
    "SlowRequestMs": 800
  },
  "Audit": {
    "Enabled": true,
    "RetentionDays": 90,
    "MaxPayloadChars": 1000,
    "ExcludePaths": [
      "/api/production/scan"
    ]
  },
  "Maintenance": {
    "IntervalMinutes": 5,
    "RepairSlaHours": 4
  },
  "Docs": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=mes_server_power;User Id=mes;Password=${MES_DB_PASSWORD};CharSet=utf8mb4;AllowPublicKeyRetrieval=true;SslMode=None",
    "Sqlite": "Data Source=mes.db"
  },
  "Jwt": {
    "Issuer": "MesApi",
    "Audience": "MesClient",
    "Key": "change_me_jwt_key_at_least_32_chars",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Seed": {
    "AdminPassword": "Admin@12345"
  }
}
