{
  "Logging": {
    "LogDirectory": "logs",
    "MinimumLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "UserName": "mes",
    "Password": "change_me_同 .env 的 RABBITMQ_PASSWORD",
    "VirtualHost": "/"
  },
  "Minio": {
    "Endpoint": "",
    "AccessKey": "mes",
    "SecretKey": "change_me_同 .env 的 MINIO_ROOT_PASSWORD",
    "Bucket": "mes-docs"
  },
  "Aps": {
    "YieldLossPercent": 3
  },
  "Diagnostics": {
    "SlowRequestMs": 800
  },
  "Audit": {
    "Enabled": true,
    "RetentionDays": 90,
    "MaxPayloadChars": 1000,
    "ExcludePaths": [
      "/api/production/scan"
    ]
  },
  "Maintenance": {
    "IntervalMinutes": 5,
    "RepairSlaHours": 4
  },
  "Docs": {
    "Enabled": true
  },
  "Demo": {
    "AllowTopUp": true
  },
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=mes_server_power;User Id=mes;Password=change_me_同 .env 的 MES_DB_PASSWORD;CharSet=utf8mb4;AllowPublicKeyRetrieval=true;SslMode=None",
    "Sqlite": "Data Source=mes.db"
  },
  "Jwt": {
    "Issuer": "MesApi",
    "Audience": "MesClient",
    "Key": "change_me_同 .env 的 JWT_KEY_至少32位随机字符",
    "AccessTokenMinutes": 480,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "https://doctorxiang.github.io"
    ]
  },
  "Seed": {
    "AdminPassword": "Admin@12345"
  }
}
